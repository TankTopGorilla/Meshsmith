<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:conv="clr-namespace:Meshsmith.App.Converters">

  <!-- ══ Surfaces ══════════════════════════════════════════════════ -->
  <SolidColorBrush x:Key="Bg0" Color="#FF0B0E12" />
  <SolidColorBrush x:Key="Bg1" Color="#FF11161D" />
  <SolidColorBrush x:Key="Bg2" Color="#FF171E27" />
  <SolidColorBrush x:Key="Bg3" Color="#FF1E2632" />
  <SolidColorBrush x:Key="Line" Color="#FF232C38" />
  <SolidColorBrush x:Key="LineStrong" Color="#FF33404F" />

  <!-- ══ Text ══════════════════════════════════════════════════════ -->
  <SolidColorBrush x:Key="TextPrimary" Color="#FFE9EEF5" />
  <SolidColorBrush x:Key="TextSecondary" Color="#FFA9B4C2" />
  <SolidColorBrush x:Key="TextMuted" Color="#FF939EAD" />

  <!-- ══ Accent ════════════════════════════════════════════════════ -->
  <SolidColorBrush x:Key="Accent" Color="#FF4AA3FF" />
  <SolidColorBrush x:Key="AccentHover" Color="#FF6DB7FF" />
  <SolidColorBrush x:Key="AccentPressed" Color="#FF2C8BE8" />
  <SolidColorBrush x:Key="AccentSoft" Color="#334AA3FF" />
  <SolidColorBrush x:Key="OnAccent" Color="#FF06101C" />

  <!-- ══ Semantic ══════════════════════════════════════════════════ -->
  <SolidColorBrush x:Key="Success" Color="#FF48C78E" />
  <SolidColorBrush x:Key="SuccessSoft" Color="#2648C78E" />
  <SolidColorBrush x:Key="Warning" Color="#FFE3B25C" />
  <SolidColorBrush x:Key="WarningSoft" Color="#26E3B25C" />
  <SolidColorBrush x:Key="Danger" Color="#FFE2705E" />
  <SolidColorBrush x:Key="DangerSoft" Color="#26E2705E" />

  <!-- ══ Surface kinds — these MUST equal MeshPreview.cs materials ══ -->
  <SolidColorBrush x:Key="KindPlane" Color="#FF93A3B5" />
  <SolidColorBrush x:Key="KindCylinder" Color="#FFE3A455" />
  <SolidColorBrush x:Key="KindCone" Color="#FF7FC08D" />
  <SolidColorBrush x:Key="KindFaceted" Color="#FFE2705E" />

  <!-- ══ Viewport ══════════════════════════════════════════════════ -->
  <LinearGradientBrush x:Key="ViewportGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF151C25" Offset="0" />
    <GradientStop Color="#FF0C1015" Offset="1" />
  </LinearGradientBrush>
  <Color x:Key="GridMinorColor">#FF19222C</Color>
  <Color x:Key="GridMajorColor">#FF27323F</Color>

  <!-- ══ Type ══════════════════════════════════════════════════════ -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- ══ Metrics ═══════════════════════════════════════════════════ -->
  <CornerRadius x:Key="CardRadius">6</CornerRadius>
  <sys:String x:Key="ShareBarWidth">304</sys:String>

  <!-- ══ Converters ════════════════════════════════════════════════ -->
  <BooleanToVisibilityConverter x:Key="BoolToVis" />
  <conv:InverseBoolToVisibilityConverter x:Key="BoolToVisInverse" />
  <conv:ShareToWidthConverter x:Key="ShareToWidth" />

  <!-- ══ Icons (16 × 16, stroked, never filled) ════════════════════ -->
  <StreamGeometry x:Key="IconCube">M8,1.8 L14,5.2 L14,11.8 L8,15.2 L2,11.8 L2,5.2 Z M2,5.2 L8,8.6 L14,5.2 M8,8.6 L8,15.2</StreamGeometry>
  <StreamGeometry x:Key="IconOpen">M2.5,4.5 L6.3,4.5 L7.8,6.3 L13.5,6.3 L13.5,12.5 L2.5,12.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconConvert">M5.7,3.6 L12.2,8 L5.7,12.4 Z</StreamGeometry>
  <StreamGeometry x:Key="IconSave">M3,2.6 L10.6,2.6 L13.4,5.4 L13.4,13.4 L3,13.4 Z M5.4,2.6 L5.4,6.4 L10.4,6.4 L10.4,2.6</StreamGeometry>
  <StreamGeometry x:Key="IconFit">M2.6,6 L2.6,2.6 L6,2.6 M10,2.6 L13.4,2.6 L13.4,6 M13.4,10 L13.4,13.4 L10,13.4 M6,13.4 L2.6,13.4 L2.6,10</StreamGeometry>
  <StreamGeometry x:Key="IconGrid">M2.6,2.6 L13.4,2.6 L13.4,13.4 L2.6,13.4 Z M2.6,7.2 L13.4,7.2 M2.6,10.8 L13.4,10.8 M7.2,2.6 L7.2,13.4 M10.8,2.6 L10.8,13.4</StreamGeometry>
  <StreamGeometry x:Key="IconAxes">M3,13 L3,3 M3,13 L13,13 M3,13 L8.6,7.4</StreamGeometry>
  <StreamGeometry x:Key="IconDrop">M8,2.6 L8,10.4 M4.6,7 L8,10.4 L11.4,7 M2.6,13.4 L13.4,13.4</StreamGeometry>
  <StreamGeometry x:Key="IconWarning">M8,2.2 L14.6,13.4 L1.4,13.4 Z M8,6.2 L8,9.8 M8,11.4 L8,12.2</StreamGeometry>
</ResourceDictionary>
