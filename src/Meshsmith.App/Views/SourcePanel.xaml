<UserControl x:Class="Meshsmith.App.Views.SourcePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="288" d:DesignHeight="820">

  <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- header -->
      <Grid>
        <TextBlock Style="{StaticResource SectionLabel}" Text="SOURCE" VerticalAlignment="Center" />
        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Height="20" Width="20"
                Command="{Binding ClearCommand}"
                AutomationProperties.Name="Clear the current model" ToolTip="Clear the current model">
          <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="{StaticResource TextMuted}" StrokeThickness="1.3"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"
                Stretch="Uniform" />
        </Button>
      </Grid>

      <!-- drop card -->
      <Border Grid.Row="1" Height="200" Padding="14"
              Margin="0,10,0,0" Background="{StaticResource Bg1}"
              MouseLeftButtonUp="OnBrowse">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
              <!-- Loaded: the card shows the file, and "Open STL" is how you replace it. -->
              <DataTrigger Binding="{Binding HasSource}" Value="True">
                <Setter Property="Cursor" Value="Arrow" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Rectangle Stroke="{StaticResource LineStrong}" StrokeDashArray="4 3" StrokeThickness="1"
                     RadiusX="5" RadiusY="5" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                      Visibility="{Binding HasSource, Converter={StaticResource BoolToVisInverse}}">
            <Path Data="{StaticResource IconDrop}" Stroke="{StaticResource TextMuted}" StrokeThickness="1.3"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" />
            <TextBlock Text="Drop an STL file" FontSize="12.5" Margin="0,10,0,0"
                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
            <TextBlock Text="or click to browse" FontSize="11.5" Margin="0,3,0,0"
                       Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
          </StackPanel>

          <StackPanel VerticalAlignment="Center" Margin="2,0"
                      Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding SourceName}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding DimensionsText}" FontSize="11.5" Margin="0,5,0,0"
                       Foreground="{StaticResource TextSecondary}" />
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
              <TextBlock Text="{Binding TrianglesText}" FontSize="11.5"
                         Foreground="{StaticResource TextMuted}" />
              <TextBlock Text=" triangles" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
            <TextBlock Text="{Binding SourcePath}" FontSize="11" Margin="0,8,0,0"
                       Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding SourcePath}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- legend -->
      <TextBlock Grid.Row="2" Style="{StaticResource SectionLabel}" Text="SURFACE LEGEND"
                 Margin="0,22,0,10" />

      <StackPanel Grid.Row="3">
        <Grid Height="26">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource KindPlane}"
                  VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Plane" FontSize="12" Margin="9,0,0,0"
                     Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding PlaneCount}" FontSize="12"
                     Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
        </Grid>

        <Grid Height="26">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource KindCylinder}"
                  VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Cylinder" FontSize="12" Margin="9,0,0,0"
                     Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding CylinderCount}" FontSize="12"
                     Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
        </Grid>

        <Grid Height="26">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource KindCone}"
                  VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Cone" FontSize="12" Margin="9,0,0,0"
                     Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding ConeCount}" FontSize="12"
                     Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
        </Grid>

        <Grid Height="26">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource KindFaceted}"
                  VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Faceted" FontSize="12" Margin="9,0,0,0"
                     Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding FacetedTriangles}" FontSize="12"
                     Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>

      <!-- pipeline checklist, anchored to the bottom so the rail reads as input → process -->
      <StackPanel Grid.Row="5">
        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14" />
        <TextBlock Style="{StaticResource SectionLabel}" Text="PIPELINE" Margin="0,0,0,10" />

        <ItemsControl ItemsSource="{Binding Stages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Height="26">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Ellipse Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{StaticResource LineStrong}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding State}" Value="Done">
                        <Setter Property="Fill" Value="{StaticResource Success}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Active">
                        <Setter Property="Fill" Value="{StaticResource Accent}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Failed">
                        <Setter Property="Fill" Value="{StaticResource Danger}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding State}" Value="Active">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Done">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Failed">
                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- error -->
      <Border Grid.Row="6" VerticalAlignment="Bottom" Padding="10,8" CornerRadius="5"
              Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}"
              BorderThickness="1" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IconWarning}" Stroke="{StaticResource Danger}" StrokeThickness="1.3"
                  Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ErrorTitle}" FontSize="9.5" FontWeight="SemiBold" Margin="6,0,0,0"
                       Foreground="{StaticResource Danger}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding ErrorText}" FontSize="11" Margin="0,5,0,0"
                     Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                      Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVis}}">
            <Button Content="Save diagnostic bundle" Style="{StaticResource GhostButton}"
                    Command="{Binding SaveDiagnosticBundleCommand}" Height="20" Padding="8,0"
                    FontSize="10" />
            <TextBlock Text="{Binding DiagnosticName}" FontSize="10" Margin="8,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextMuted}" ToolTip="{Binding DiagnosticPath}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
