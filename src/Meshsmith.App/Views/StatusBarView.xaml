<UserControl x:Class="Meshsmith.App.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="28">

  <Border Height="28" Background="{StaticResource Bg0}"
          BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
    <Grid Margin="16,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding StageText}" FontSize="9.5" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
        <Border Width="150" Height="3" CornerRadius="1.5" Background="{StaticResource Bg3}"
                Margin="10,0,0,0" VerticalAlignment="Center"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
          <Border HorizontalAlignment="Left" Background="{StaticResource Accent}" CornerRadius="1.5"
                  Width="{Binding ProgressShare, Converter={StaticResource ShareToWidth}, ConverterParameter=150}" />
        </Border>
        <TextBlock Text="{Binding ProgressText}" FontSize="9.5" Margin="8,0,0,0"
                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="{Binding ActivityText}" FontSize="9.5" Margin="10,0,0,0"
                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                   ToolTip="Elapsed · how much CPU the conversion process is using · time since the last progress update" />
        <Button Content="Cancel" Style="{StaticResource GhostButton}" Height="20" Padding="8,0"
                FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center"
                Command="{Binding CancelCommand}" ToolTip="Stop the running conversion"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
      </StackPanel>

      <TextBlock Text="{Binding StatusRight}" FontSize="11" HorizontalAlignment="Right"
                 VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                 Typography.NumeralAlignment="Tabular" />
    </Grid>
  </Border>
</UserControl>
