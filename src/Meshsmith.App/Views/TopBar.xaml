<UserControl x:Class="Meshsmith.App.Views.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="52">

  <Border Height="52" Background="{StaticResource Bg1}"
          BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
    <Grid Margin="16,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- brand -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource AccentSoft}"
                BorderBrush="{StaticResource Accent}" BorderThickness="1">
          <Path Data="{StaticResource IconCube}" Stroke="{StaticResource Accent}" StrokeThickness="1.2"
                StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Text="MESHSMITH" FontSize="12" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimary}" />
          <TextBlock Text="STL  →  STEP / IGES" FontSize="9.5" Margin="0,1,0,0"
                     Foreground="{StaticResource TextMuted}" />
        </StackPanel>
      </StackPanel>

      <!-- actions -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenCommand}"
                AutomationProperties.Name="Open STL" ToolTip="Open an STL mesh (Ctrl+O)">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IconOpen}" Style="{StaticResource ButtonIcon}" />
            <TextBlock Text="Open STL" Margin="7,0,0,0" />
          </StackPanel>
        </Button>

        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConvertCommand}"
                Margin="8,0,0,0" AutomationProperties.Name="Convert"
                ToolTip="Convert to a STEP solid (F5)">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IconConvert}" Style="{StaticResource ButtonIcon}" />
            <TextBlock Text="Convert" Margin="7,0,0,0" />
          </StackPanel>
        </Button>

        <Button Style="{StaticResource GhostButton}" Command="{Binding ReRunCommand}"
                Margin="8,0,0,0" AutomationProperties.Name="Re-run"
                ToolTip="Convert the same part again with the current settings">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IconConvert}" Style="{StaticResource ButtonIcon}" />
            <TextBlock Text="Re-run" Margin="7,0,0,0" />
          </StackPanel>
        </Button>

        <!-- recent files: the popup carries no view-model state, its toggle owns IsOpen -->
        <Grid Margin="8,0,0,0">
          <ToggleButton x:Name="RecentToggle" Style="{StaticResource IconToggle}"
                        AutomationProperties.Name="Recent files"
                        ToolTip="Open a recently converted part">
            <Path Data="{StaticResource IconOpen}" Style="{StaticResource ButtonIcon}" />
          </ToggleButton>

          <Popup IsOpen="{Binding IsChecked, ElementName=RecentToggle, Mode=TwoWay}"
                 PlacementTarget="{Binding ElementName=RecentToggle}" Placement="Bottom"
                 StaysOpen="False" AllowsTransparency="True">
            <Border Style="{StaticResource Card}" Padding="6" Margin="0,4,0,0" MinWidth="260"
                    MaxWidth="420">
              <ItemsControl ItemsSource="{Binding RecentFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource GhostButton}" Height="24"
                            HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.OpenRecentCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="{Binding}">
                      <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Popup>
        </Grid>

        <Button Style="{StaticResource IconButton}" Margin="4,0,0,0"
                Command="{Binding SettingsCommand}" AutomationProperties.Name="Settings"
                ToolTip="Settings">
          <Path Data="{StaticResource IconFit}" Style="{StaticResource ButtonIcon}" />
        </Button>

        <Border Width="1" Height="18" Background="{StaticResource Line}" Margin="16,0" />

        <Button Style="{StaticResource GhostButton}" Command="{Binding SaveStepCommand}"
                AutomationProperties.Name="Save STEP" ToolTip="Save STEP (Ctrl+S)">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IconSave}" Style="{StaticResource ButtonIcon}" />
            <TextBlock Text="Save STEP" Margin="7,0,0,0" />
          </StackPanel>
        </Button>

        <Button Style="{StaticResource GhostButton}" Command="{Binding SaveIgesCommand}"
                Margin="8,0,0,0" AutomationProperties.Name="Save IGES"
                ToolTip="Save IGES (Ctrl+Shift+S)">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IconSave}" Style="{StaticResource ButtonIcon}" />
            <TextBlock Text="Save IGES" Margin="7,0,0,0" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
