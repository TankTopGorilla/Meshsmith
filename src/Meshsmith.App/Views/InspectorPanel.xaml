<UserControl x:Class="Meshsmith.App.Views.InspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="336" d:DesignHeight="820">

  <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
    <Grid>
      <ScrollViewer Style="{StaticResource PaneScroll}">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- header -->
          <Grid>
            <TextBlock Style="{StaticResource SectionLabel}" Text="RESULT" VerticalAlignment="Center" />
            <Border CornerRadius="9" Padding="8,3" HorizontalAlignment="Right">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource Bg3}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsValid}" Value="True">
                      <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Fill" Value="{StaticResource TextMuted}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsValid}" Value="True">
                          <Setter Property="Fill" Value="{StaticResource Success}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ValidityText}" FontSize="9.5" FontWeight="SemiBold"
                           Margin="6,0,0,0" Foreground="{StaticResource TextSecondary}" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- empty state -->
          <Border Grid.Row="1" Margin="0,20,0,0" Padding="0,26" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisInverse}}">
            <StackPanel>
              <TextBlock Text="Nothing converted yet" FontSize="12.5" Foreground="{StaticResource TextSecondary}" />
              <TextBlock Text="Load an STL and press Convert. Faces, volume and deviation land here."
                         FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                         Margin="0,6,0,0" />
            </StackPanel>
          </Border>

          <!-- stat grid -->
          <Grid Grid.Row="1" Margin="0,16,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12,10">
              <StackPanel>
                <TextBlock Style="{StaticResource StatLabel}" Text="FACES" />
                <TextBlock Style="{StaticResource StatValue}" Text="{Binding FacesText}" Margin="0,3,0,0" />
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10">
              <StackPanel>
                <TextBlock Style="{StaticResource StatLabel}" Text="SOLIDS" />
                <TextBlock Style="{StaticResource StatValue}" Text="{Binding SolidsText}" Margin="0,3,0,0" />
              </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource StatLabel}" Text="VOLUME  ·  MM³" />
                <TextBlock Style="{StaticResource StatValue}" Text="{Binding VolumeText}" Margin="0,3,0,0" />
              </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="12,10" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource StatLabel}" Text="DEVIATION  ·  MM" />
                <TextBlock Style="{StaticResource StatValue}" Text="{Binding DeviationText}" Margin="0,3,0,0" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- surface mix -->
          <StackPanel Grid.Row="2" Margin="0,20,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource SectionLabel}" Text="SURFACE MIX" Margin="0,0,0,10" />
            <Border Height="8" CornerRadius="4" Background="{StaticResource Bg3}" ClipToBounds="True"
                    Visibility="{Binding HasMix, Converter={StaticResource BoolToVis}}">
              <StackPanel Orientation="Horizontal">
                <Rectangle Fill="{StaticResource KindPlane}"
                           Width="{Binding PlaneShare, Converter={StaticResource ShareToWidth}, ConverterParameter={StaticResource ShareBarWidth}}" />
                <Rectangle Fill="{StaticResource KindCylinder}"
                           Width="{Binding CylinderShare, Converter={StaticResource ShareToWidth}, ConverterParameter={StaticResource ShareBarWidth}}" />
                <Rectangle Fill="{StaticResource KindCone}"
                           Width="{Binding ConeShare, Converter={StaticResource ShareToWidth}, ConverterParameter={StaticResource ShareBarWidth}}" />
              </StackPanel>
            </Border>

            <Grid Height="26" Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="44" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource KindPlane}" />
                <TextBlock Text="Plane" FontSize="11.5" Margin="8,0,0,0"
                           Foreground="{StaticResource TextSecondary}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding PlaneCount}" FontSize="11.5"
                         Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding PlanePercentText}" FontSize="11.5"
                         HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}"
                         VerticalAlignment="Center" />
            </Grid>

            <Grid Height="26">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="44" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource KindCylinder}" />
                <TextBlock Text="Cylinder" FontSize="11.5" Margin="8,0,0,0"
                           Foreground="{StaticResource TextSecondary}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding CylinderCount}" FontSize="11.5"
                         Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding CylinderPercentText}" FontSize="11.5"
                         HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}"
                         VerticalAlignment="Center" />
            </Grid>

            <Grid Height="26">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="44" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource KindCone}" />
                <TextBlock Text="Cone" FontSize="11.5" Margin="8,0,0,0"
                           Foreground="{StaticResource TextSecondary}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding ConeCount}" FontSize="11.5"
                         Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding ConePercentText}" FontSize="11.5"
                         HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}"
                         VerticalAlignment="Center" />
            </Grid>

            <Border Margin="0,8,0,0" Padding="10,7" CornerRadius="5"
                    Background="{StaticResource WarningSoft}" BorderBrush="{StaticResource Warning}"
                    BorderThickness="1"
                    Visibility="{Binding HasFacetedFallback, Converter={StaticResource BoolToVis}}">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconWarning}" Stroke="{StaticResource Warning}" StrokeThickness="1.3"
                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="{Binding FacetedText}" FontSize="10.5" Margin="7,0,0,0"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- details -->
          <StackPanel Grid.Row="3" Margin="0,20,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource SectionLabel}" Text="DETAILS" Margin="0,0,0,8" />
            <Grid Height="24">
              <TextBlock Text="Fit tolerance" FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ToleranceText}" FontSize="11.5" HorizontalAlignment="Right"
                         Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            </Grid>
            <Grid Height="26">
              <TextBlock Text="Override · mm" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                         VerticalAlignment="Center" />
              <TextBox Style="{StaticResource FieldBox}" Width="90" HorizontalAlignment="Right"
                       Text="{Binding ToleranceInput, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Tolerance override in millimetres"
                       ToolTip="Leave empty to derive the tolerance from the model" />
            </Grid>
            <Grid Height="24">
              <TextBlock Text="Edges" FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding EdgesText}" FontSize="11.5" HorizontalAlignment="Right"
                         Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            </Grid>
            <Grid Height="24">
              <TextBlock Text="Triangles" FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding TriangleCountText}" FontSize="11.5" HorizontalAlignment="Right"
                         Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            </Grid>
            <Grid Height="24">
              <TextBlock Text="Elapsed" FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ElapsedText}" FontSize="11.5" HorizontalAlignment="Right"
                         Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            </Grid>
            <Grid Height="24">
              <TextBlock Text="Result kind" FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding KindText}" FontSize="11.5" HorizontalAlignment="Right"
                         Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>

          <!-- warnings -->
          <StackPanel Grid.Row="4" Margin="0,20,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource SectionLabel}" Text="WARNINGS" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Warnings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="5" Height="5" Fill="{StaticResource Warning}" VerticalAlignment="Top"
                             Margin="0,6,0,0" />
                    <TextBlock Text="{Binding}" FontSize="11.5" Margin="8,0,0,0"
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="None" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                       Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisInverse}}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
