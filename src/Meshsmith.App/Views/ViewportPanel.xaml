<UserControl x:Class="Meshsmith.App.Views.ViewportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="http://helix-toolkit.org/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="816" d:DesignHeight="820">

  <Grid ClipToBounds="True">
    <Border Background="{StaticResource ViewportGradient}" />

    <h:HelixViewport3D x:Name="Viewport" Background="Transparent"
                       ShowCoordinateSystem="{Binding ShowAxes}"
                       CoordinateSystemWidth="80" CoordinateSystemHeight="80"
                       ShowViewCube="True" ShowFrameRate="False"
                       IsHeadLightEnabled="True" CameraRotationMode="Turntable"
                       ZoomExtentsWhenLoaded="False">
      <h:HelixViewport3D.Camera>
        <PerspectiveCamera Position="160,-200,140" LookDirection="-160,200,-140"
                           UpDirection="0,0,1" FieldOfView="35" />
      </h:HelixViewport3D.Camera>
      <h:SunLight Altitude="58" Azimuth="-40" Brightness="0.62" Ambient="0.30" />
    </h:HelixViewport3D>

    <!-- empty state -->
    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Path Data="{StaticResource IconCube}" Stroke="{StaticResource LineStrong}" StrokeThickness="1"
            Width="46" Height="46" Stretch="Uniform" StrokeLineJoin="Round"
            HorizontalAlignment="Center" />
      <TextBlock Text="No model yet" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,0"
                 Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
      <TextBlock Text="Drop an STL file here, or pick one from disk."
                 FontSize="11.5" Margin="0,5,0,0" Foreground="{StaticResource TextMuted}"
                 HorizontalAlignment="Center" />
      <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}"
              HorizontalAlignment="Center" Margin="0,18,0,0" Padding="18,0" Height="32">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IconOpen}" Style="{StaticResource ButtonIcon}" />
          <TextBlock Text="Open STL" Margin="7,0,0,0" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- view toolbar -->
    <Border Style="{StaticResource FloatingBar}" HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="14">
      <StackPanel>
        <Button Style="{StaticResource IconButton}" Click="OnFit"
                AutomationProperties.Name="Fit to view" ToolTip="Fit to view">
          <Path Data="{StaticResource IconFit}" Style="{StaticResource ButtonIcon}" Width="14" Height="14" />
        </Button>
        <Rectangle Height="1" Fill="{StaticResource Line}" Margin="5,4" />
        <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding ShowGrid, Mode=TwoWay}"
                      AutomationProperties.Name="Ground grid" ToolTip="Ground grid">
          <Path Data="{StaticResource IconGrid}" Style="{StaticResource ButtonIcon}" Width="14" Height="14" />
        </ToggleButton>
        <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding ShowAxes, Mode=TwoWay}"
                      AutomationProperties.Name="Orientation axes" ToolTip="Orientation axes">
          <Path Data="{StaticResource IconAxes}" Style="{StaticResource ButtonIcon}" Width="14" Height="14" />
        </ToggleButton>
      </StackPanel>
    </Border>

    <!-- drag hint -->
    <TextBlock Text="Drag to orbit   ·   Scroll to zoom   ·   Right-drag to pan"
               FontSize="11" Foreground="{StaticResource TextMuted}" Opacity="0.8"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,14"
               IsHitTestVisible="False" />

    <!-- render failure -->
    <Border x:Name="RenderError" Visibility="Collapsed" HorizontalAlignment="Center"
            VerticalAlignment="Bottom" Margin="0,0,0,44" Padding="12,8" CornerRadius="5"
            Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}"
            BorderThickness="1">
      <TextBlock x:Name="RenderErrorText" FontSize="11" Foreground="{StaticResource TextSecondary}" />
    </Border>
  </Grid>
</UserControl>
